		<section name="node">
			<attribute key="id" type="int">7</attribute>
			<attribute key="label" type="String">2 Dimensional arrays are arrays where the data element's position is referred to, by two indices. The name specifies two dimensions, that is, row and column. E.g. we have an array
arr =[[5, 9],
      [17,13]]
here if we want to access element 17, we will access it by using arr[1][0], where 1 and 0 indicates the row and column of element 17 respectively. Please go through lecture recordings where 2-dimensional arrays are covered.</attribute>
			<section name="graphics">
				<attribute key="x" type="double">695.8078367813832</attribute>
				<attribute key="y" type="double">90.23885953050102</attribute>
				<attribute key="w" type="double">581.2486880472559</attribute>
				<attribute key="h" type="double">104.11134323202393</attribute>
				<attribute key="type" type="String">rectangle</attribute>
				<attribute key="raisedBorder" type="boolean">false</attribute>
				<attribute key="fill" type="String">#FFCC00</attribute>
				<attribute key="outline" type="String">#000000</attribute>
			</section>
			<section name="LabelGraphics">
				<attribute key="text" type="String">2 Dimensional arrays are arrays where the data element's position is referred to, by two indices. The name specifies two dimensions, that is, row and column. E.g. we have an array
arr =[[5, 9],
      [17,13]]
here if we want to access element 17, we will access it by using arr[1][0], where 1 and 0 indicates the row and column of element 17 respectively. Please go through lecture recordings where 2-dimensional arrays are covered.</attribute>
				<attribute key="fontSize" type="int">12</attribute>
				<attribute key="fontName" type="String">Dialog</attribute>
				<attribute key="configuration" type="String">CroppingLabel</attribute>
				<attribute key="contentWidth" type="double">581.2486880472559</attribute>
