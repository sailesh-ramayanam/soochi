				<attribute key="fontName" type="String">Dialog</attribute>
				<attribute key="configuration" type="String">CroppingLabel</attribute>
				<attribute key="contentWidth" type="double">223.4172787384009</attribute>
				<attribute key="contentHeight" type="double">51.28125</attribute>
