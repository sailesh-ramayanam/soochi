				<attribute key="x" type="double">2312.913261673728</attribute>
				<attribute key="y" type="double">4889.5670633624</attribute>
				<attribute key="w" type="double">519.1007666623914</attribute>
				<attribute key="h" type="double">474.9740073762513</attribute>
