		<section name="node">
			<attribute key="id" type="int">57</attribute>
			<attribute key="label" type="String">Below is an implementation of the arrays approach.
1. let charsArray = [], countsArray = [];
2. for (let i = 0; i &lt; word.length; ++i) {
3.     let c = word.charAt(i);
4.     let cIndex = charsArray.indexOf(c);
5.     if (cIndex === -1) {
6.         // c is not present in charsArray
7.         charsArray.append(c);
8.         countsArray.append(1);
9.     } else {
10.        ++countsArray[cIndex];
11.    }
12.}</attribute>
			<section name="graphics">
				<attribute key="x" type="double">4112.0559523809525</attribute>
