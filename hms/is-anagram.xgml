			</section>
			<section name="LabelGraphics">
				<attribute key="text" type="String">Below is an implementation of the hashmap approach.
1. let charMap = new Map();
2. for (let i = 0; i &lt; word.length; ++i) {
3.     let c = word.charAt(i);
4.     if (charMap.has(c)) {
5.         charMap.set(c, charMap.get(c) + 1);
6.     } else {
7.         charMap.set(c, 1);
8.     }
9. }</attribute>
