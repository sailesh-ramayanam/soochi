		<section name="node">
			<attribute key="id" type="int">85</attribute>
			<attribute key="label" type="String">Below is an implementation of the hashmap approach.
1. let charMap = new Map();
2. for (let i = 0; i &lt; word.length; ++i) {
3.     let c = word.charAt(i);
4.     if (charMap.has(c)) {
5.         charMap.set(c, charMap.get(c) + 1);
6.     } else {
7.         charMap.set(c, 1);
8.     }
9. }</attribute>
			<section name="graphics">
				<attribute key="x" type="double">6742.8388888888885</attribute>
				<attribute key="y" type="double">3666.606133206331</attribute>
				<attribute key="w" type="double">434.70583818195485</attribute>
				<attribute key="h" type="double">226.26595140973825</attribute>
				<attribute key="type" type="String">rectangle</attribute>
