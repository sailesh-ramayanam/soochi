		<section name="node">
			<attribute key="id" type="int">110</attribute>
			<attribute key="label" type="String">Following is what I came up with.

1. Take firstWord
2. Store the counts of each unique character from firstWord, in w1Map
3. Take secondWord
4. Store the counts of each unique character from secondWord, in w2Map
5. let areAnagrams = true;
6. if w1Map.size() !== w2Map.size() {
7.     areAnagrams = false;
8. } else {
9.     for every key c in w1Map {
10.        if c is not present in w2Map {
11.            areAnagrams = false;
12.            break;
13.        } else if (w1Map.get(c) !== w2Map.get(c)) {
14.            areAnagrams = false;
15.            break;
16.        }
17.    }
18.}
19.if (areAnagrams) {
20.    // firstWord and secondWord are anagrams
21.} else {
22.    // firstWord and secondWord are not anagrams
23.}</attribute>
