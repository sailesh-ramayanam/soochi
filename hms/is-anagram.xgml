		<section name="node">
			<attribute key="id" type="int">45</attribute>
			<attribute key="label" type="String">Can you try to write down an algorithm based on the above exercise?</attribute>
			<section name="graphics">
				<attribute key="x" type="double">4918.140477494591</attribute>
				<attribute key="y" type="double">2583.326065026292</attribute>
				<attribute key="w" type="double">207.21106750315596</attribute>
				<attribute key="h" type="double">76.89505530447343</attribute>
