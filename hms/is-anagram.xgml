				<attribute key="text" type="String">Can you try to write down an algorithm based on the above exercise?</attribute>
				<attribute key="fontSize" type="int">12</attribute>
				<attribute key="fontName" type="String">Dialog</attribute>
				<attribute key="configuration" type="String">CroppingLabel</attribute>
				<attribute key="contentWidth" type="double">207.21106750315596</attribute>
				<attribute key="contentHeight" type="double">51.28125</attribute>
				<attribute key="autoSizePolicy" type="String">node_width</attribute>
