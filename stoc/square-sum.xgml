			</section>
			<section name="LabelGraphics">
				<attribute key="text" type="String">let loanAmount = 1000;
let interest = "20";
What will be the values of loanAmount+interest, loanAmount+loanAmount?</attribute>
				<attribute key="fontSize" type="int">12</attribute>
